# --- NiFi connection ---------------------------------------------------------
NIFI_URL=https://localhost:8443
NIFI_USERNAME=admin
# NiFi single-user passwords need at least 12 characters
NIFI_PASSWORD=change-me-min-12-chars
# true (default) verifies the certificate; set false only for a local self-signed NiFi
NIFI_VERIFY_SSL=false
# NIFI_CA_BUNDLE=/path/to/ca.pem
# NIFI_PROXY_CONTEXT_PATH=/nifi-prefix

# --- MCP behaviour -------------------------------------------------------------
# readonly (default) | full
MCP_MODE=readonly
# all (default) or a list from: core,flow,services,parameters,ports,guides
MCP_TOOLSETS=all
# true: write/control tools only report what they would do
MCP_DRY_RUN=false
MCP_AUDIT_LOG=true
MCP_AUDIT_LOG_PATH=./logs/audit.log

# --- Transport -------------------------------------------------------------------
# stdio (default, local clients) | sse | http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
